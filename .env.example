# Public synthetic FHIR sandbox. No credentials required.
FHIR_BASE_URL=https://r4.smarthealthit.org
HOST=127.0.0.1
PORT=3121
# Set the AWS region and Bedrock Mantle model ID used by your team.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
DYNAMODB_TABLE_NAME=
S3_BUCKET_NAME=
# Optional audio services; add actual values only in your ignored .env file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=scribe_v2_medical
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
BEDROCK_DIAGNOSTICS_ENABLED=false
# Configure AWS_PROFILE in your shell; never put access keys in this file.
