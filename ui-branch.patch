+              node.textContent = "";
+            } else if (node.dataset.format === "page") {
+              node.textContent = `p. ${value}`;
+            } else {
+              node.textContent = Array.isArray(value) ? value.join(" · ") : String(value);
+            }
+          }
+
+          for (const node of document.querySelectorAll("[data-source-page]")) {
+            const page = getPath(plan, node.dataset.sourcePage);
+            node.hidden = page === undefined;
+            node.replaceChildren(icon("doc"), `From your document · p. ${page}`);
+          }
+
+          for (const node of document.querySelectorAll("[data-demo-only]")) {
+            node.hidden = !plan.isDemo;
+          }
+        }
+
+        function renderMedicationCheckIn(medications) {
+          const list = document.querySelector("#med-list");
+          list.replaceChildren(
+            ...medications.map((medication, index) => {
+              const id = medication.id || `medication-${index}`;
+              const doses = Math.max(1, Number(medication.dosesPerDay) || 1);
+              const doseLabel = doses === 1 ? "Time taken" : `Dose ${Array.from({ length: doses }, (_, i) => i + 1).join(" / dose ")} times`;
+              const doseInputs = Array.from({ length: doses }, (_, doseIndex) =>
+                element("input", {
+                  attrs: {
+                    type: "time",
+                    name: `${id}-time-${doseIndex + 1}`,
+                    "aria-label": doses === 1
+                      ? `${medication.label}: time taken`
+                      : `${medication.label}: dose ${doseIndex + 1} time`,
+                  },
+                }),
+              );
+
+              return element("fieldset", { className: "med-row" }, [
+                element("legend", { text: medication.label }),
+                element("label", { className: "choice choice-primary" }, [
+                  element("input", { attrs: { type: "radio", name: id, value: "taken" } }),
+                  "Taken",
+                ]),
+                element("label", { className: "choice" }, [
+                  element("input", { attrs: { type: "radio", name: id, value: "not-taken" } }),
+                  "Not taken",
+                ]),
+                element("div", { className: "dose-times" }, [
+                  element("span", { text: doseLabel, attrs: { "aria-hidden": "true" } }),
+                  ...doseInputs,
+                ]),
+              ]);
+            }),
+          );
+        }
+
+        function renderMedicationDetails(medications) {
+          document.querySelector("#med-groups").replaceChildren(
+            ...asList(medications.groups).map((group) =>
+              element("div", { className: "med-group" }, [
+                element("p", { className: "group-title", text: group.title }),
+                ...asList(group.items).map((item) => element("p", { text: item })),
+              ]),
+            ),
+          );
+
+          document.querySelector("#schedule").replaceChildren(
+            ...asList(medications.schedule).map((row) =>
+              element("div", {}, [
+                element("dt", { text: row.label }),
+                element("dd", { className: row.missing ? "missing" : "", text: row.value }),
+              ]),
+            ),
+          );
+
+          fillNote(document.querySelector("#stopped-note"), "info", medications.stopped?.title || "", medications.stopped?.items);
+          fillNote(document.querySelector("#teaching-note"), "info", medications.teaching?.title || "", medications.teaching?.items);
+        }
+
+        function renderFollowUp(followUp) {
+          document.querySelector("#task-list").replaceChildren(
+            ...asList(followUp.tasks).map((task, index) =>
+              element("label", { className: "task" }, [
+                element("input", { attrs: { type: "checkbox", name: `task-${task.id || index}` } }),
+                element("span", {}, [
+                  element("span", { className: "task-title", text: task.title, attrs: { style: "display:block" } }),
+                  element("span", { className: "task-detail", text: task.detail }),
+                ]),
+              ]),
+            ),
+          );
+
+          fillNote(
+            document.querySelector("#daily-care-note"),
+            "info",
+            "Daily care · From your document",
+            followUp.dailyCare,
+          );
+        }
+
+        function renderAppointments(appointments) {
+          document.querySelector("#appointment-list").replaceChildren(
+            ...asList(appointments.items).map((appointment) =>
+              element("article", { className: "appointment" }, [
+                element("div", { className: "appointment-header" }, [
+                  element("h3", { text: appointment.title }),
+                  element("span", { className: "tag tag-warning", text: appointment.status || "Status not provided" }),
+                ]),
+                ...asList(appointment.details).map((detail, index) =>
+                  element("p", { className: index === 0 ? "muted" : "", text: detail }),
+                ),
+              ]),
+            ),
+          );
+        }
+
+        function updateProgress() {
+          const medicationGroups = [...document.querySelectorAll("#med-list fieldset")];
+          const medsDone = medicationGroups.length > 0
+            && medicationGroups.every((group) => group.querySelector("input[type='radio']:checked"));
+          const weightDone = Boolean(form.querySelector("input[name='weighed']:checked"));
+          const done = Number(medsDone) + Number(weightDone);
+          const total = 2;
+          progressText.textContent = `${done} of ${total} tasks ready`;
+          progressFill.style.width = `${(done / total) * 100}%`;
+          checkinStatus.textContent = done === total
+            ? "Today’s check-in is complete. It stays on this device and is not submitted."
+            : "";
+        }
+
+        function renderPlan(plan) {
+          renderFields(plan);
+          renderMedicationCheckIn(asList(plan.checkIn?.medications));
+          renderMedicationDetails(plan.medications || {});
+          renderFollowUp(plan.followUp || {});
+          renderAppointments(plan.appointments || {});
+
+          const symptomList = document.querySelector("#warning-symptoms");
+          symptomList.replaceChildren(
+            ...asList(plan.warningSigns?.symptoms).map((symptom) => element("li", { text: symptom })),
+          );
+
+          updateProgress();
+        }
+
+        const now = new Date();
+        document.querySelector("#record-date").value = [
+          now.getFullYear(),
+          String(now.getMonth() + 1).padStart(2, "0"),
+          String(now.getDate()).padStart(2, "0"),
+        ].join("-");
+
+        form.addEventListener("change", updateProgress);
+        form.addEventListener("submit", (event) => event.preventDefault());
+
+        fetch("/api/recovery-plan", { headers: { Accept: "application/json" } })
+          .then(async (response) => {
+            const result = await response.json().catch(() => {
+              throw new Error("The server returned an invalid response.");
+            });
+            if (!response.ok) throw new Error(result.error || "The recovery plan could not be loaded.");
+            return result;
+          })
+          .then(renderPlan)
+          .catch((error) => {
+            loadError.textContent = error instanceof TypeError
+              ? "Could not reach the server. Open this page from the running local server and try again."
+              : error.message;
+            loadError.hidden = false;
+            updateProgress();
+          })
+          .finally(() => main.removeAttribute("aria-busy"));
+      })();
+    </script>
+  </body>
+</html>
