+        }
+
+        function asList(value) {
+          return Array.isArray(value) ? value : [];
+        }
+
+        function fillNote(container, iconName, title, items) {
+          container.replaceChildren(
+            icon(iconName),
+            element("div", {}, [
+              element("p", { className: "note-title", text: title }),
+              ...asList(items).map((item) => element("p", { text: item })),
+            ]),
